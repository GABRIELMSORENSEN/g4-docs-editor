{
  "name": "g4-docs-editor",
  "private": true,
  "version": "1.1.0",
  "description": "Editor PDF local G4 DOCS EDITOR.",
  "author": "Gabriel Sorensen",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "icons": "node scripts/generate-icons.mjs",
    "build": "npm run icons && vite build",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs'); ['dist','release-builds'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}))\"",
    "lint": "tsc --noEmit",
    "dist:desktop": "npm run dist:win",
    "dist:win": "npm run build && node scripts/prepare-desktop.mjs && electron-builder --win nsis portable --publish never",
    "dist:appimage": "npm run build && node scripts/prepare-desktop.mjs && electron-builder --linux AppImage --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^42.3.2",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.25.0",
    "playwright": "^1.60.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "build": {
    "appId": "com.g4.docs.editor",
    "productName": "G4 DOCS EDITOR",
    "copyright": "Copyright \u00a9 2026 Gabriel Sorensen. Todos os direitos reservados.",
    "directories": {
      "buildResources": "build",
      "output": "release-builds",
      "app": "desktop-stage"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "G4-DOCS-EDITOR-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "G4 DOCS EDITOR",
      "license": "LICENSE"
    },
    "portable": {
      "artifactName": "G4-DOCS-EDITOR-Portable-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "artifactName": "G4-DOCS-EDITOR-${version}-${arch}.${ext}"
    },
    "npmRebuild": false
  },
  "dependencies": {}
}
